#!/usr/bin/env bash
# Runs the Kapelos stack; every make target is a call to this.
# I wrote it for bash 3.2 as well, because that is the bash macOS ships.
set -euo pipefail

# readlink -f is missing on older macOS, so a symlink on PATH is followed by hand.
resolve_home() {
  local source="${BASH_SOURCE[0]}" dir
  while [[ -L $source ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ $source == /* ]] || source="$dir/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

KAPELOS_HOME="$(resolve_home)"
cd "$KAPELOS_HOME"

# Every setting the rest of Kapelos reads is here, so no file below has to be sourced before another.
ENV_FILE="${KAPELOS_ENV:-.env}"
SITES_DIR=etc/sites
STORES_DIR=var/stores
MODULES_FILE=etc/modules.tsv
SHARE_COMMANDS=share/commands
AUDIT_CHECKS=etc/audit/checks.tsv
SNAPSHOT_VOLUMES="db-data opensearch-data rabbitmq-data"
# What a store's own .kapelos/settings.env may set: facts about the store, never ports, passwords or paths on this machine.
PROJECT_KEYS="PHP_VERSION NODE_VERSION MARIADB_VERSION OPENSEARCH_VERSION VALKEY_VERSION RABBITMQ_VERSION VARNISH_VERSION NGINX_VERSION INSTALL_SOURCEGUARDIAN MAGENTO_NGINX_CONF STORES DEPLOY_LOCALES MANIPULUS_THEME AUDIT_PATHS"

# The counts a run adds up: what kapelos site audit and kapelos doctor found, and what self-test found.
REPORT_FAILS=0
REPORT_WARNS=0
SELF_TEST_FAILED=0

# The rest of Kapelos, a file per job. lib/core.sh holds what the others build on.
# shellcheck source=lib/core.sh
. "$KAPELOS_HOME/lib/core.sh"
# shellcheck source=lib/sites.sh
. "$KAPELOS_HOME/lib/sites.sh"
# shellcheck source=lib/store.sh
. "$KAPELOS_HOME/lib/store.sh"
# shellcheck source=lib/adopt.sh
. "$KAPELOS_HOME/lib/adopt.sh"
# shellcheck source=lib/stack.sh
. "$KAPELOS_HOME/lib/stack.sh"
# shellcheck source=lib/checks.sh
. "$KAPELOS_HOME/lib/checks.sh"
# shellcheck source=lib/tools.sh
. "$KAPELOS_HOME/lib/tools.sh"
# shellcheck source=lib/commands.sh
. "$KAPELOS_HOME/lib/commands.sh"
# shellcheck source=lib/selftest.sh
. "$KAPELOS_HOME/lib/selftest.sh"

usage() {
  usage_text
  local custom
  custom="$(list_custom_commands 2>/dev/null || true)"
  [[ -z $custom ]] || printf '\nCommands from this store and from you\n%s\n' "$custom"
}

usage_text() {
  cat <<'EOF'
Usage: kapelos <command> [arguments]

Getting a store
  demo                   Download and install a demo store, with no questions
  interactive            Ask a few questions, then set a store up without asking again
  env [SITE]             Write settings with generated passwords: .env, or etc/sites/SITE.env
  adopt PATH --datadir DIR | --dump FILE [--name SITE] [--url URL] [--store HOST=CODE] [--proxy NETWORK] [--no-reindex]
                         Run a store you already have, as it is: its code where it lives, a copy of
                         its database, and its own env.php untouched

Sites, for more than one project
  sites                  List the sites and which one is active
  trust [PATH]           Allow a store's .kapelos/compose.yaml and .kapelos/commands to run
  stores [apply]         Which store each hostname in STORES runs; apply sets their addresses
  use SITE               Switch to a site, stopping whichever one is running
  site audit [SITE]      Check a site for vulnerable dependencies, credentials and unsafe settings
  site remove SITE [-y]  Delete a site's containers, database, snapshots and files; its code stays

The stack
  up                     Start everything, or apply a change to the settings, and wait until it serves
  down                   Stop everything, keeping the database and search index
  restart [SERVICE...]   Restart services, after editing a file in etc/
  ps                     What is running, and whether it is healthy
  logs [SERVICE...]      Follow the logs
  info                   Every address, port and login: store, admin, mail, database, Valkey, OpenSearch, RabbitMQ
  doctor                 Check this machine and this site: tools, memory, disk, ports, names, versions
  build                  Build the PHP image
  cert                   Issue a trusted certificate for APP_HOST with mkcert, and serve it

Working in the store
  magento-install        Install Magento into an empty database
  import DUMP            Load a database dump (.sql or .sql.gz) into an empty database
  connect                Point an existing store's settings at Kapelos, after import
  <group>:<command>      Any Magento command runs directly: kapelos cache:flush, kapelos setup:upgrade
  magento ARGS...        The long form, for a Magento command without a colon
  debug <command>        Run a Magento command with Xdebug, connecting to your IDE
  shell                  A shell in the PHP container, at the Magento root
  composer ARGS...       Run Composer
  db [dump [FILE]]       A MariaDB prompt on the store's database, or a gzipped dump of it
  snapshot [save|restore|delete] [NAME] [-y]
                         Save the database, search index and queue, and put them back in seconds
  valkey [cache|session] valkey-cli on the cache or the session instance
  cache-reset            Empty every cache: Magento, Valkey and Varnish. Sessions are kept
  cron [on|off|run]      Magento's scheduled jobs and queue consumers; off unless you turn them on
  queues                 Declare the store's queues in RabbitMQ without setup:upgrade, and check each is there
  node|npm|npx|grunt ARGS...
                         Node for the front end, at the store's root; NODE_VERSION picks the version
  modules [add|remove] [NAME...]
                         The Kingletas modules: which are installed, or add and remove them
  sample-data            Add Magento's sample products, for tools that need a catalogue
  commands [add|remove] [NAME...] [--user] [-f]
                         The commands Kapelos ships for you to use and change: which are
                         installed, or put them in this store or in every store you work on

Testing the running store
  bluetir [MODE] [ARGS...]
                         Drive a browser through the store with bluetir; order mode needs DISPOSABLE=yes
  drexbot [ARGS...]      Run drexbot against the store, capturing its baseline first
  manipulus [COMMAND] [ARGS...]
                         Plan and build RequireJS bundles with manipulus, after kapelos deploy
  ci [ACT ARGS...]       Run the store's GitHub Actions workflows on this machine with act
  deploy                 Rehearse a production deployment on this tree
  develop                Go back to developer mode after a deploy
  test [unit|integration] [PATH...]
                         Run the store's PHPUnit tests, for app/code unless PATH says otherwise

Kapelos itself
  check                  Everything a commit has to pass
  check-image            Build the PHP image and check every extension Magento needs is in it
  self-test              Build a throwaway store and prove every feature works, then remove it

Your commands: a file in the store's .kapelos/commands or in ~/.config/kapelos/commands is a command too.
Kapelos ships seven to start from: kapelos commands add.
Every command also runs through make: make up, make magento ARGS="cache:flush".
A command with a colon is Magento's; Kapelos's own commands never have one.
Set KAPELOS_ENV to use a settings file other than .env for one command.
EOF
}

main() {
  local command="${1:-help}"
  [[ $# -gt 0 ]] && shift

  case "$command" in
    adopt) cmd_adopt "$@" ;;
    bluetir) cmd_bluetir "$@" ;;
    build) compose build php ;;
    cache-reset) cmd_cache_reset ;;
    cert) cmd_cert ;;
    check) cmd_check ;;
    check-image) cmd_check_image ;;
    ci) cmd_ci "$@" ;;
    commands) cmd_commands "$@" ;;
    composer) exec_php composer "$@" ;;
    connect) cmd_connect ;;
    cron) cmd_cron "$@" ;;
    db) cmd_db "$@" ;;
    debug) cmd_debug "$@" ;;
    demo) cmd_demo ;;
    deploy) cmd_deploy ;;
    develop) cmd_develop ;;
    doctor) cmd_doctor ;;
    down) compose down ;;
    drexbot) cmd_drexbot "$@" ;;
    env) cmd_env "$@" ;;
    help | -h | --help) usage ;;
    import) cmd_import "$@" ;;
    info) cmd_info ;;
    interactive) cmd_interactive ;;
    logs) compose logs -f "$@" ;;
    magento) magento "$@" ;;
    magento-install) cmd_magento_install ;;
    manipulus) cmd_manipulus "$@" ;;
    modules) cmd_modules "$@" ;;
    node | npm | npx | grunt) cmd_node "$command" "$@" ;;
    ps) compose ps "$@" ;;
    queues) cmd_queues ;;
    restart) compose restart "$@" ;;
    sample-data) cmd_sample_data ;;
    self-test) cmd_self_test ;;
    shell) exec_php bash ;;
    site) cmd_site "$@" ;;
    sites) cmd_sites ;;
    snapshot) cmd_snapshot "$@" ;;
    stores) cmd_stores "$@" ;;
    test) cmd_test "$@" ;;
    trust) cmd_trust "$@" ;;
    up) cmd_up ;;
    use) cmd_use "$@" ;;
    valkey) cmd_valkey "$@" ;;
    *:*) magento "$command" "$@" ;;
    *)
      local file
      if file="$(custom_command_file "$command")"; then
        run_custom_command "$file" "$@"
      fi
      usage >&2
      echo "kapelos: unknown command: $command" >&2
      exit 2
      ;;
  esac
}

main "$@"
