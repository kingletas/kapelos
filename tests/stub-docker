#!/usr/bin/env bash
# A stand-in for docker that answers from files in $STUB_DOCKER, logs every call, and starts nothing.
# containers holds id|project|folder|memory|state lines, volumes holds name|project|snapshot-project lines,
# and compose-config is what docker compose config prints.
set -euo pipefail

printf '%s\n' "$*" >>"$STUB_DOCKER/calls"
if [[ ${STUB_DOCKER_DOWN:-no} == yes ]]; then
  echo "Cannot connect to the Docker daemon" >&2
  exit 1
fi
containers="$STUB_DOCKER/containers"
volumes="$STUB_DOCKER/volumes"
touch "$containers" "$volumes"

unexpected() {
  echo "stub docker: unexpected call: $*" >&2
  exit 2
}

stub_ps() {
  local all=no quiet=no filter="" format="" id project folder memory state
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -a) all=yes ;;
      -q) quiet=yes ;;
      --filter)
        filter="$2"
        shift
        ;;
      --format)
        format="$2"
        shift
        ;;
      *) unexpected ps "$1" ;;
    esac
    shift
  done
  while IFS='|' read -r id project folder memory state; do
    [[ -n $id ]] || continue
    [[ $all == yes || $state == running ]] || continue
    case "$filter" in
      label=com.docker.compose.project) [[ -n $project ]] || continue ;;
      label=com.docker.compose.project.working_dir=*) [[ $folder == "${filter#*working_dir=}" ]] || continue ;;
      label=com.docker.compose.project=*) [[ $project == "${filter#*project=}" ]] || continue ;;
      *) unexpected ps --filter "$filter" ;;
    esac
    if [[ $quiet == yes ]]; then
      echo "$id"
    elif [[ $format == *working_dir* ]]; then
      echo "$folder"
    else
      echo "$project"
    fi
  done <"$containers"
}

stub_inspect() {
  local id want project folder memory state
  [[ ${1:-} == --format ]] || unexpected inspect "$@"
  shift 2
  for want in "$@"; do
    while IFS='|' read -r id project folder memory state; do
      if [[ $id == "$want" ]]; then
        echo "$project $memory $folder"
      fi
    done <"$containers"
  done
}

stub_volume_ls() {
  local label value name project snapshot
  [[ ${1:-} == -q && ${2:-} == --filter ]] || unexpected volume ls "$@"
  label="${3#label=}"
  value="${label#*=}"
  label="${label%%=*}"
  while IFS='|' read -r name project snapshot; do
    [[ -n $name ]] || continue
    case "$label" in
      com.docker.compose.project) [[ $project == "$value" ]] || continue ;;
      kapelos.snapshot.project) [[ $snapshot == "$value" ]] || continue ;;
      *) unexpected volume ls "$@" ;;
    esac
    echo "$name"
  done <"$volumes"
}

case "${1:-}" in
  ps)
    shift
    stub_ps "$@"
    ;;
  inspect)
    shift
    stub_inspect "$@"
    ;;
  volume)
    [[ ${2:-} == ls ]] || unexpected "$@"
    shift 2
    stub_volume_ls "$@"
    ;;
  compose)
    for arg in "$@"; do
      if [[ $arg == config ]]; then
        cat "$STUB_DOCKER/compose-config"
        exit 0
      fi
    done
    unexpected "$@"
    ;;
  *) unexpected "$@" ;;
esac
