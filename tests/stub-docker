#!/usr/bin/env bash
# A stand-in for docker that answers from files in $STUB_DOCKER, logs every call, and starts nothing.
# containers holds id|project|folder|memory|state lines, with an optional sixth field for the bytes in use that
# docker stats reports; volumes holds name|project|snapshot-project lines, with the snapshot's name and when it
# was saved as a fourth and fifth field, and compose-config is what docker compose config prints. networks,
# when it is there, holds name|project lines for the networks docker network ls finds; with STUB_NETWORK_KEPT
# set, docker compose down for that network's project removes its containers and then fails the way Docker does
# when it will not let go of the network, and with STUB_CONTAINER_KEPT set as well the containers stay. images, when it
# is there, holds a NAME:TAG line for each image docker image ls finds; with STUB_IMAGE_KEPT set to one of them,
# docker image rm refuses it the way Docker refuses an image a container still uses. data-root,
# when it is there, holds the folder docker info names as Docker's own, and volume-kib holds name|KiB lines for
# what du finds in a volume. A volume made or removed is added to volumes or taken out of it.
set -euo pipefail

printf '%s\n' "$*" >>"$STUB_DOCKER/calls"
if [[ ${STUB_DOCKER_DOWN:-no} == yes ]]; then
  echo "Cannot connect to the Docker daemon" >&2
  exit 1
fi
containers="$STUB_DOCKER/containers"
volumes="$STUB_DOCKER/volumes"
touch "$containers" "$volumes"

unexpected() {
  echo "stub docker: unexpected call: $*" >&2
  exit 2
}

# Whether a docker compose call is for PROJECT, by its -p or its settings file. One that names neither counts as for it.
down_is_for() {
  local project="$1" named=""
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p) named="$2" ;;
      --env-file) [[ ! -f $2 ]] || named="$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$2")" ;;
    esac
    shift
  done
  [[ -z $named || $named == "$project" ]]
}

stub_ps() {
  local all=no quiet=no filter="" format="" id project folder memory state usage
  # With STUB_PS_FAILS set, docker ps cannot answer, as when the daemon stops between two commands.
  if [[ -n ${STUB_PS_FAILS:-} ]]; then
    echo "Cannot connect to the Docker daemon" >&2
    exit 1
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -a) all=yes ;;
      -q) quiet=yes ;;
      --filter)
        filter="$2"
        shift
        ;;
      --format)
        format="$2"
        shift
        ;;
      *) unexpected ps "$1" ;;
    esac
    shift
  done
  while IFS='|' read -r id project folder memory state usage; do
    [[ -n $id ]] || continue
    [[ $all == yes || $state == running ]] || continue
    case "$filter" in
      label=com.docker.compose.project) [[ -n $project ]] || continue ;;
      label=com.docker.compose.project.working_dir=*) [[ $folder == "${filter#*working_dir=}" ]] || continue ;;
      label=com.docker.compose.project=*) [[ $project == "${filter#*project=}" ]] || continue ;;
      *) unexpected ps --filter "$filter" ;;
    esac
    if [[ $quiet == yes ]]; then
      echo "$id"
    elif [[ $format == *working_dir* ]]; then
      echo "$folder"
    else
      echo "$project"
    fi
  done <"$containers"
}

stub_inspect() {
  local id want project folder memory state usage
  [[ ${1:-} == --format ]] || unexpected inspect "$@"
  shift 2
  for want in "$@"; do
    while IFS='|' read -r id project folder memory state usage; do
      if [[ $id == "$want" ]]; then
        echo "$project $memory $folder"
      fi
    done <"$containers"
  done
}

# docker stats --no-stream --format '{{.MemUsage}}' ID...: the sixth field in MiB, as Docker prints it, over the limit.
stub_stats() {
  local want id project folder memory state usage
  [[ ${1:-} == --no-stream && ${2:-} == --format ]] || unexpected stats "$@"
  shift 3
  for want in "$@"; do
    while IFS='|' read -r id project folder memory state usage; do
      [[ $id == "$want" ]] || continue
      awk -v u="${usage:-0}" -v m="$memory" 'BEGIN { printf "%.1fMiB / %.0fMiB\n", u / 1048576, m / 1048576 }'
    done <"$containers"
  done
}

# docker volume ls -q --filter label=KEY=VALUE prints names; --filter ... --format, as snapshot_names asks,
# prints each matching volume's snapshot name.
stub_volume_ls() {
  local label value name project snapshot snapshot_name created names=no
  if [[ ${1:-} == -q && ${2:-} == --filter ]]; then
    names=yes
    shift
  fi
  [[ ${1:-} == --filter ]] || unexpected volume ls "$@"
  [[ $names == yes || ${3:-} == --format ]] || unexpected volume ls "$@"
  label="${2#label=}"
  value="${label#*=}"
  label="${label%%=*}"
  while IFS='|' read -r name project snapshot snapshot_name created; do
    [[ -n $name ]] || continue
    case "$label" in
      com.docker.compose.project) [[ $project == "$value" ]] || continue ;;
      kapelos.snapshot.project) [[ $snapshot == "$value" ]] || continue ;;
      *) unexpected volume ls "$@" ;;
    esac
    if [[ $names == yes ]]; then echo "$name"; else echo "$snapshot_name"; fi
  done <"$volumes"
}

# docker volume inspect -f FORMAT NAME: when the snapshot it belongs to was saved.
stub_volume_inspect() {
  local name project snapshot snapshot_name created
  [[ ${1:-} == -f && ${2:-} == *kapelos.snapshot.created* && $# -eq 3 ]] || unexpected volume inspect "$@"
  while IFS='|' read -r name project snapshot snapshot_name created; do
    if [[ $name == "$3" ]]; then
      echo "$created"
      return 0
    fi
  done <"$volumes"
  exit 1
}

# docker volume create --label KEY=VALUE... NAME: one more line in volumes.
stub_volume_create() {
  local snapshot="" snapshot_name="" created=""
  while [[ ${1:-} == --label ]]; do
    case "$2" in
      kapelos.snapshot=*) snapshot_name="${2#*=}" ;;
      kapelos.snapshot.project=*) snapshot="${2#*=}" ;;
      kapelos.snapshot.created=*) created="${2#*=}" ;;
      *) unexpected volume create --label "$2" ;;
    esac
    shift 2
  done
  [[ $# -eq 1 ]] || unexpected volume create "$@"
  echo "$1||$snapshot|$snapshot_name|$created" >>"$volumes"
  echo "$1"
}

stub_volume_rm() {
  [[ $# -eq 1 ]] || unexpected volume rm "$@"
  grep -q "^$1|" "$volumes" || { echo "Error: No such volume: $1" >&2 && exit 1; }
  grep -v "^$1|" "$volumes" >"$volumes.new" || true
  mv "$volumes.new" "$volumes"
  echo "$1"
}

# docker info --format '{{.DockerRootDir}}': the folder in data-root, or a failure, as where Docker can't be asked.
stub_info() {
  [[ ${1:-} == --format && ${2:-} == *DockerRootDir* ]] || unexpected info "$@"
  [[ -f $STUB_DOCKER/data-root ]] || exit 1
  cat "$STUB_DOCKER/data-root"
}

# docker run LIMITS -v NAME:/from:ro alpine du -sk /from: the volume's line in volume-kib, as du prints it.
# docker run LIMITS -v FROM:/from:ro -v TO:/to alpine sh -c ...: one volume copied into another, which calls records.
# docker run LIMITS alpine true: the helper that does nothing, started to learn whether Docker takes the limits.
# LIMITS is what every helper container runs under, and a run without them is refused: --rm --network none
# --memory M --cpus N, then --cgroup-parent NAME when the machine names one. With STUB_RUN_REFUSED set, every
# run fails with those words, as Docker does for a limit it won't take.
stub_run() {
  local name kib want
  [[ ${1:-} == --rm && ${2:-} == --network && ${3:-} == none && ${4:-} == --memory && ${6:-} == --cpus ]] ||
    unexpected run "$@"
  shift 7
  if [[ ${1:-} == --cgroup-parent ]]; then
    shift 2
  fi
  if [[ -n ${STUB_RUN_REFUSED:-} ]]; then
    echo "docker: Error response from daemon: $STUB_RUN_REFUSED" >&2
    exit 125
  fi
  if [[ ${1:-} == alpine && ${2:-} == true && $# -eq 2 ]]; then
    return 0
  fi
  if [[ ${1:-} == -v && ${2:-} == *:/from:ro && ${3:-} == -v && ${4:-} == *:/to && ${5:-} == alpine && ${6:-} == sh ]]; then
    return 0
  fi
  [[ ${1:-} == -v && ${3:-} == alpine && ${4:-} == du ]] || unexpected run "$@"
  want="${2%%:*}"
  while IFS='|' read -r name kib; do
    if [[ $name == "$want" ]]; then
      printf '%s\t/from\n' "$kib"
      return 0
    fi
  done <"$STUB_DOCKER/volume-kib"
  exit 1
}

case "${1:-}" in
  info)
    shift
    stub_info "$@"
    ;;
  run)
    shift
    stub_run "$@"
    ;;
  ps)
    shift
    stub_ps "$@"
    ;;
  inspect)
    shift
    stub_inspect "$@"
    ;;
  stats)
    shift
    stub_stats "$@"
    ;;
  volume)
    action="${2:-}"
    shift 2
    case "$action" in
      ls) stub_volume_ls "$@" ;;
      inspect) stub_volume_inspect "$@" ;;
      create) stub_volume_create "$@" ;;
      rm) stub_volume_rm "$@" ;;
      *) unexpected volume "$action" "$@" ;;
    esac
    ;;
  network)
    # docker network ls --filter label=com.docker.compose.project=P --format 'network {{.Name}}'
    [[ ${2:-} == ls && ${3:-} == --filter && ${4:-} == label=com.docker.compose.project=* && ${5:-} == --format ]] ||
      unexpected "$@"
    [[ -f $STUB_DOCKER/networks ]] || exit 0
    while IFS='|' read -r name project; do
      [[ $project == "${4#*project=}" ]] && echo "network $name"
    done <"$STUB_DOCKER/networks"
    exit 0
    ;;
  image)
    # docker image ls --filter reference=REPOSITORY --format '{{.Repository}}:{{.Tag}}', and docker image rm NAME:TAG
    case "${2:-}" in
      ls)
        [[ ${3:-} == --filter && ${4:-} == reference=* && ${5:-} == --format ]] || unexpected "$@"
        [[ -f $STUB_DOCKER/images ]] || exit 0
        # Docker's filter takes the repository whole, so this does too.
        awk -F: -v repository="${4#reference=}" '$1 == repository' "$STUB_DOCKER/images"
        ;;
      rm)
        if [[ -n ${STUB_IMAGE_KEPT:-} && ${3:-} == "$STUB_IMAGE_KEPT" ]]; then
          echo "Error response from daemon: conflict: unable to remove repository reference \"$3\" (must force) - container 0123456789ab is using its referenced image" >&2
          exit 1
        fi
        grep -vxF -- "${3:-}" "$STUB_DOCKER/images" >"$STUB_DOCKER/images.new" || true
        mv "$STUB_DOCKER/images.new" "$STUB_DOCKER/images"
        ;;
      *) unexpected "$@" ;;
    esac
    exit 0
    ;;
  compose)
    for arg in "$@"; do
      if [[ $arg == config ]]; then
        cat "$STUB_DOCKER/compose-config"
        exit 0
      fi
      if [[ $arg == down && -n ${STUB_NETWORK_KEPT:-} ]] && down_is_for "${STUB_NETWORK_KEPT%_default}" "$@"; then
        # Docker removes the containers first and fails at the network; STUB_CONTAINER_KEPT leaves them too.
        if [[ -z ${STUB_CONTAINER_KEPT:-} ]]; then
          awk -F'|' -v project="${STUB_NETWORK_KEPT%_default}" '$2 != project' "$containers" >"$containers.new"
          mv "$containers.new" "$containers"
        fi
        echo "Error response from daemon: error while removing network: network $STUB_NETWORK_KEPT has active endpoints" >&2
        exit 1
      fi
      # Stopping, and making a site's containers and volumes, are logged in calls, which is all a test needs of them.
      case "$arg" in down | stop | create) exit 0 ;; esac
    done
    unexpected "$@"
    ;;
  *) unexpected "$@" ;;
esac
