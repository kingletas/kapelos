#!/usr/bin/env bash
# Several sites from one folder at once: up admits another store by the memory, load and disk left, refuses a
# site whose ports a running one publishes, use stops nothing, down SITE and stop-others stop what they
# name, and sites shows what each uses. Offline: docker is tests/stub-docker, and nothing starts a container.
set -euo pipefail

ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRATCH="$(mktemp -d)"
trap 'rm -rf "$SCRATCH"' EXIT
FAILURES=0
GIB=1073741824

mkdir -p "$SCRATCH/bin"
cp "$ROOT/tests/stub-docker" "$SCRATCH/bin/docker"
export PATH="$SCRATCH/bin:$PATH"
export STUB_DOCKER="$SCRATCH/docker"
export KAPELOS_MEMINFO="$SCRATCH/meminfo" KAPELOS_LOADAVG="$SCRATCH/loadavg"
unset KAPELOS_RESERVE_GIB KAPELOS_MAX_LOAD KAPELOS_MAX_RUNNING KAPELOS_MEM_BUDGET_GIB

result() {
  if [[ $1 -eq 0 ]]; then
    printf 'ok    %s\n' "$2"
  else
    printf 'FAIL  %s\n' "$2"
    FAILURES=$((FAILURES + 1))
  fi
}

# Runs the rest of the line as a test named by the first word, without letting a failure end the script.
check() {
  local name="$1" status=0
  shift
  "$@" || status=$?
  result "$status" "$name"
}

reset_docker() {
  rm -rf "$STUB_DOCKER"
  mkdir -p "$STUB_DOCKER"
  : >"$STUB_DOCKER/containers"
  : >"$STUB_DOCKER/volumes"
  : >"$STUB_DOCKER/calls"
  : >"$STUB_DOCKER/compose-config"
}

# The machine as the room check reads it: GiB available, and the five-minute load.
machine() {
  printf 'MemAvailable: %s kB\n' $(($1 * 1024 * 1024)) >"$KAPELOS_MEMINFO"
  echo "0.00 $2 0.00 1/100 1" >"$KAPELOS_LOADAVG"
}

reset_docker
machine 64 0.00
A="$SCRATCH/a"
mkdir -p "$A" "$SCRATCH/store"
cp -R "$ROOT/bin" "$ROOT/lib" "$ROOT/.env.example" "$ROOT/compose.yaml" "$A/"
A="$(cd -P "$A" && pwd)"
kapelos() { (cd "$A" && bin/kapelos "$@"); }
kapelos env web >/dev/null
# On web's ports on purpose, as every site was before slots: the clash up has to refuse.
kapelos env other --slot 0 >/dev/null
out="$(kapelos env apart)"
check "a new site gets the first block of ports no other site here uses" grep -qx HTTP_PORT=8180 "$A/etc/sites/apart.env"
check "and says so" grep -q "Slot 0's ports are taken by another site here, so apart gets slot 1." <<<"$out"
check "the first site of a folder still gets slot 0" grep -qx HTTP_PORT=8080 "$A/etc/sites/web.env"
for site in web other apart; do
  sed -i.bak "s|^MAGENTO_SRC=.*|MAGENTO_SRC=$SCRATCH/store|" "$A/etc/sites/$site.env"
done

# cmd_up for one site in a process of its own, as bin/kapelos runs it, stopping where the stack would start.
cat >"$SCRATCH/up" <<EOF
set -euo pipefail
cd "$A"
KAPELOS_HOME="$A"
ENV_FILE="etc/sites/\$1.env"
SITES_DIR=etc/sites
STORES_DIR=var/stores
PORT_KEYS="HTTP_PORT HTTPS_PORT DB_PORT MAIL_UI_PORT OPENSEARCH_PORT RABBITMQ_UI_PORT LIVERELOAD_PORT"
PORT_SLOT_STRIDE=100
PROJECT_KEYS=""
. lib/core.sh
. lib/sites.sh
. lib/stack.sh
. lib/scale.sh
scale_before_up() {
  echo "reached the stack"
  exit 0
}
cmd_up
EOF

up_passes() {
  local out
  out="$(bash "$SCRATCH/up" "$1" 2>&1)" || return 1
  [[ $out == "reached the stack" ]]
}

up_refused() {
  local site="$1" out expect
  shift
  out="$(bash "$SCRATCH/up" "$site" 2>&1)" && return 1
  for expect in "$@"; do
    grep -qF -- "$expect" <<<"$out" || return 1
  done
}

running() {
  echo "$1|kapelos-$2|$A|$((8 * GIB))|running|$3" >>"$STUB_DOCKER/containers"
}

# --- room for another store ----------------------------------------------

machine 1 0.00
check "a first store starts whatever is free, as before" up_passes web

reset_docker
running a1 apart $((3 * GIB))
machine 20 0.00
check "another store starts when the reserve stays free after it" up_passes web
machine 12 0.00
check "and is refused when it would eat into the reserve, with the numbers" up_refused web \
  "starting web would leave 6.0 GiB of memory free: 12.0 GiB is free now, and it has never been measured, so it counts as 6 GiB. KAPELOS_RESERVE_GIB keeps 8 GiB free." \
  "Running now: apart"
mkdir -p "$A/var/sites/web"
echo $((2 * GIB)) >"$A/var/sites/web/footprint"
check "a site measured small is admitted where an unmeasured one isn't" up_passes web
echo $((5 * GIB)) >"$A/var/sites/web/footprint"
check "a measured site is refused on what it used" up_refused web "and it used 5.0 GiB when it last ran"
KAPELOS_RESERVE_GIB=0 check "KAPELOS_RESERVE_GIB=0 turns the reserve off" up_passes web
KAPELOS_RESERVE_GIB=4 check "a smaller reserve admits it" up_passes web
rm -f "$A/var/sites/web/footprint"

machine 64 7.00
KAPELOS_MAX_LOAD=6 check "a machine over KAPELOS_MAX_LOAD holds another store back" up_refused web \
  "this machine's load over the last five minutes is 7.00, over KAPELOS_MAX_LOAD=6"
machine 64 5.00
KAPELOS_MAX_LOAD=6 check "and admits it once the load is under" up_passes web
machine 64 99.00
KAPELOS_MAX_LOAD=0 check "KAPELOS_MAX_LOAD=0 turns the load check off" up_passes web

machine 64 0.00
for bad in -1 8.5 lots; do
  KAPELOS_RESERVE_GIB="$bad" check "KAPELOS_RESERVE_GIB=$bad is refused" up_refused web "KAPELOS_RESERVE_GIB is $bad"
done
for bad in -1 high 6.; do
  KAPELOS_MAX_LOAD="$bad" check "KAPELOS_MAX_LOAD=$bad is refused" up_refused web "KAPELOS_MAX_LOAD is $bad"
done

running w1 web $((4 * GIB))
machine 1 99.00
check "a site already running is re-applied, not admitted again" up_passes web

# --- room on Docker's disk -------------------------------------------------

# A stand-in df: the space free is whatever the file $STUB_DF names holds, in KiB.
cat >"$SCRATCH/bin/df" <<'EOF'
#!/usr/bin/env bash
echo "Filesystem 1024-blocks Used Available Capacity Mounted on"
echo "stub 0 0 $(cat "$STUB_DF") 0% /"
EOF
chmod +x "$SCRATCH/bin/df"
export STUB_DF="$SCRATCH/disk-free-kib"
mkdir -p "$SCRATCH/docker-data"
unset KAPELOS_DISK_RESERVE_GIB

# Docker's data folder as the disk check reads it: where it is, and the GiB free there.
disk() {
  printf '%s' "$SCRATCH/docker-data" >"$STUB_DOCKER/data-root"
  echo $(($1 * 1024 * 1024)) >"$STUB_DF"
}

reset_docker
machine 64 0.00
disk 100
check "a store starts when the disk reserve stays free" up_passes web
disk 12
check "a first store is refused too when Docker's disk is under the reserve, with the numbers" up_refused web \
  "starting web needs room where Docker keeps its data ($SCRATCH/docker-data): 12.0 GiB is free there, and KAPELOS_DISK_RESERVE_GIB keeps 20 GiB free." \
  "kapelos snapshot lists this site's snapshots"
KAPELOS_DISK_RESERVE_GIB=0 check "KAPELOS_DISK_RESERVE_GIB=0 turns the disk reserve off" up_passes web
KAPELOS_DISK_RESERVE_GIB=10 check "a smaller disk reserve admits it" up_passes web
for bad in -1 2.5 lots; do
  KAPELOS_DISK_RESERVE_GIB="$bad" check "KAPELOS_DISK_RESERVE_GIB=$bad is refused" up_refused web "KAPELOS_DISK_RESERVE_GIB is $bad"
done
running w1 web $((4 * GIB))
disk 1
check "a site already running is re-applied whatever the disk holds" up_passes web
reset_docker
echo 1048576 >"$STUB_DF"
check "where Docker's folder can't be read, nothing is asked and nothing is said" up_passes web

# cmd_snapshot save for one site in a process of its own, stopping where it would pause the database.
cat >"$SCRATCH/snapshot" <<EOF
set -euo pipefail
cd "$A"
KAPELOS_HOME="$A"
ENV_FILE="etc/sites/\$1.env"
SITES_DIR=etc/sites
STORES_DIR=var/stores
PORT_KEYS="HTTP_PORT HTTPS_PORT DB_PORT MAIL_UI_PORT OPENSEARCH_PORT RABBITMQ_UI_PORT LIVERELOAD_PORT"
PORT_SLOT_STRIDE=100
PROJECT_KEYS=""
SNAPSHOT_VOLUMES="db-data opensearch-data rabbitmq-data"
. lib/core.sh
. lib/sites.sh
. lib/stack.sh
. lib/scale.sh
snapshot_names() { :; }
step() {
  echo "reached the copy"
  exit 0
}
cmd_snapshot save before-upgrade
EOF

snapshot_passes() {
  local out
  out="$(bash "$SCRATCH/snapshot" "$1" 2>&1)" || return 1
  [[ $out == "reached the copy" ]]
}

snapshot_refused() {
  local site="$1" out expect
  shift
  out="$(bash "$SCRATCH/snapshot" "$site" 2>&1)" && return 1
  for expect in "$@"; do
    grep -qF -- "$expect" <<<"$out" || return 1
  done
}

# What du finds in web's three volumes: 24 GiB, 6 GiB and 1 GiB.
volumes_of_web() {
  printf '%s\n' "kapelos-web_db-data|$((24 * 1024 * 1024))" "kapelos-web_opensearch-data|$((6 * 1024 * 1024))" \
    "kapelos-web_rabbitmq-data|$((1024 * 1024))" >"$STUB_DOCKER/volume-kib"
}

reset_docker
running w1 web $((4 * GIB))
volumes_of_web
disk 60
check "a snapshot is taken when the reserve stays free after its copy" snapshot_passes web
disk 40
check "and is refused when its copy would eat into the reserve, with the numbers" snapshot_refused web \
  "a snapshot of web copies 31.0 GiB, which would leave 9.0 GiB free where Docker keeps its data ($SCRATCH/docker-data): 40.0 GiB is free now, and KAPELOS_DISK_RESERVE_GIB keeps 20 GiB free." \
  "kapelos snapshot delete NAME removes an old one"
KAPELOS_DISK_RESERVE_GIB=0 check "KAPELOS_DISK_RESERVE_GIB=0 lets the snapshot through" snapshot_passes web
: >"$STUB_DOCKER/volume-kib"
out="$(bash "$SCRATCH/snapshot" web 2>&1)" && status=0 || status=$?
check "a volume that can't be measured doesn't stop the snapshot" test "$status" -eq 0
check "and it says the reserve wasn't checked" grep -q "can't measure db-data, so the disk reserve isn't checked for this snapshot" <<<"$out"
rm -f "$STUB_DOCKER/data-root"
volumes_of_web
check "where Docker's folder can't be read, a snapshot asks nothing and says nothing" snapshot_passes web

# --- ports ---------------------------------------------------------------

reset_docker
machine 64 0.00
running o1 other $GIB
check "a site on the same ports as a running one is refused, naming both" up_refused web \
  "web and other, which is running, both publish HTTP_PORT on 8080"
reset_docker
running p1 apart $GIB
check "a site on its own ports starts beside a running one" up_passes web

# --- moving a site's ports ------------------------------------------------

reset_docker
kapelos env moved --slot 0 >/dev/null
sed -i.bak "s|^MAGENTO_SRC=.*|MAGENTO_SRC=$SCRATCH/store|" "$A/etc/sites/moved.env"
out="$(kapelos site ports moved)"
check "site ports moves a site to the first free block" grep -qx HTTP_PORT=8280 "$A/etc/sites/moved.env"
check "every port with it" grep -qx DB_PORT=13506 "$A/etc/sites/moved.env"
check "and its base URL" grep -qx MAGENTO_BASE_URL=http://moved.test:8280/ "$A/etc/sites/moved.env"
check "and says how to move the store's own address" grep -q "kapelos magento config:set web/unsecure/base_url http://moved.test:8280/" <<<"$out"
out="$(kapelos site ports moved --slot 1 2>&1)" && status=0 || status=$?
check "a slot another site here holds is refused" test "$status" -ne 0
check "naming whose it is" grep -q "slot 1 is apart's" <<<"$out"
running m1 moved $GIB
out="$(kapelos site ports moved --slot 5 2>&1)" && status=0 || status=$?
check "a running site's ports don't move" test "$status" -ne 0
check "and it says to stop it first" grep -q "moved is running, and its ports can't change under it" <<<"$out"
check "info names the site's slot and block" grep -q "Ports        slot 2: HTTP 8280" <<<"$(KAPELOS_ENV=etc/sites/moved.env kapelos info)"
rm "$A/etc/sites/moved.env"

# --- use, down, stop-others and sites --------------------------------------

reset_docker
running w1 web $((2 * GIB))
running o1 other $((3 * GIB))
out="$(kapelos use apart)"
check "use stops nothing" bash -c "! grep -q down '$STUB_DOCKER/calls'"
check "and says what is still running" grep -q "Still running: other web. kapelos down SITE stops one." <<<"$out"
check "and switches .env" test "$(readlink "$A/.env")" = "etc/sites/apart.env"

out="$(kapelos sites)"
check "sites shows a running site's memory and port" grep -qE '^  other +running +3.0 GiB +8080 ' <<<"$out"
check "and the active site's marker" grep -qE '^\* apart +stopped +- +8180 ' <<<"$out"

: >"$STUB_DOCKER/calls"
kapelos down other >/dev/null
check "down SITE stops that site" grep -q "etc/sites/other.env down" "$STUB_DOCKER/calls"
check "and records what it used first" test "$(cat "$A/var/sites/other/footprint")" = $((3 * GIB))
out="$(kapelos down nowhere 2>&1)" && status=0 || status=$?
check "down with a site that doesn't exist is refused" test "$status" -ne 0
check "and says so" grep -q "there's no site called nowhere" <<<"$out"

: >"$STUB_DOCKER/calls"
kapelos use web quiet >/dev/null
kapelos stop-others >/dev/null
check "stop-others stops the others" grep -q "etc/sites/other.env down" "$STUB_DOCKER/calls"
check "and not the active site" bash -c "! grep -q 'etc/sites/web.env down' '$STUB_DOCKER/calls'"
reset_docker
running w1 web $GIB
check "stop-others with nothing else running says so" grep -q "Nothing else is running." <<<"$(kapelos stop-others)"

echo
if [[ $FAILURES -eq 0 ]]; then
  echo "all passed"
else
  echo "$FAILURES failed"
  exit 1
fi
