# Serves the mounted tree through the nginx configuration Magento ships with it.
include /etc/nginx/kapelos/stores.conf;

upstream fastcgi_backend {
    server unix:/run/php/fpm.sock;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 64m;
    fastcgi_read_timeout 600s;

    set $MAGE_ROOT /app;
    set $MAGE_DEBUG_SHOW_ARGS 0;

    include ${MAGENTO_NGINX_CONF};
}

# nginx's connection counts and PHP-FPM's pool status for Prometheus on the stack's own network. Traefik and
# Varnish send nothing to this port, so none of the store's addresses reach it.
server {
    listen 8081;
    server_name _;

    location = /nginx-status {
        stub_status;
    }

    # Every parameter FPM sees is fixed here, so no client can name a script, set a PHP value or ask for the
    # full listing, which holds each worker's request URI.
    location = /fpm-status {
        fastcgi_pass_request_headers off;
        fastcgi_pass_request_body off;
        fastcgi_param SCRIPT_NAME /fpm-status;
        fastcgi_param SCRIPT_FILENAME /fpm-status;
        fastcgi_param REQUEST_METHOD GET;
        fastcgi_param QUERY_STRING openmetrics;
        fastcgi_pass fastcgi_backend;
    }

    location / {
        return 404;
    }
}
