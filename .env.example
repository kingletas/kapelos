# Copy to .env with `kapelos env` or `make env`, which also fill in every blank password.

# The Magento tree to run. Everything else has a default.
MAGENTO_SRC=

# Which compose files make up the stack. Add :compose.proxy.yaml to sit behind a
# reverse proxy, and :compose.local.yaml for additions only your machine needs.
COMPOSE_FILE=compose.yaml
COMPOSE_PROJECT_NAME=kapelos

# Turns on the bundled Mailpit. Remove it if you already run a mail sink, and
# point SMTP_HOST and SMTP_PORT at that one instead.
COMPOSE_PROFILES=mail
SMTP_HOST=mailpit
SMTP_PORT=1025

# Where the store answers. With the proxy overlay, use https://<APP_HOST>/.
MAGENTO_BASE_URL=http://magento.test:8080/
APP_HOST=magento.test
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
DB_PORT=13306
MAIL_UI_PORT=8025
OPENSEARCH_PORT=9200
RABBITMQ_UI_PORT=15672
LIVERELOAD_PORT=35729

# The reverse proxy's Docker network, used by compose.proxy.yaml only.
PROXY_NETWORK=
# Every hostname the reverse proxy sends here, comma-separated. Empty means APP_HOST and every STORES hostname.
PROXY_HOSTS=

# Files the PHP container writes belong to this user. `kapelos env` fills them in.
HOST_UID=
HOST_GID=

# What the debugging container's Xdebug does: debug, develop, profile or trace, comma-separated.
# The normal PHP container always has Xdebug off. Run `kapelos up` after changing it.
XDEBUG_MODE=debug

# Needed only for extensions encoded with SourceGuardian. Rebuild after changing it.
INSTALL_SOURCEGUARDIAN=false

# Nginx includes this file from inside the Magento tree.
MAGENTO_NGINX_CONF=/app/nginx.conf.sample
# Other storefronts, as hostname=store_code pairs separated by spaces: STORES="second.test=second_store".
# Every other hostname runs the store's default. kapelos stores apply sets their addresses.
STORES=

# Magento's scheduled jobs and queue consumers: yes to run them. An adopted store's jobs use its real settings.
CRON=no

# The env.php an adopted store runs with, laid over its own by compose.adopt.yaml. kapelos adopt sets it.
KAPELOS_ENV_PHP=

# What kapelos site audit scans for credentials when the store isn't a git repository,
# separated by spaces. In a repository it scans the files git tracks, whatever this says.
AUDIT_PATHS=app/code app/design app/i18n app/etc/config.php

# The theme kapelos manipulus bundles, as area/Vendor/theme.
MANIPULUS_THEME=frontend/Magento/luma

# yes lets bluetir and drexbot place orders and register accounts, which nothing takes back.
# kapelos demo and interactive set it for the stores they make; a store you bring stays no.
DISPOSABLE=no

# Languages `kapelos deploy` builds static files for, separated by spaces.
DEPLOY_LOCALES=en_US

# Replace with the VCL Magento generates to turn on full-page caching.
VARNISH_VCL=./etc/varnish/default.vcl

DB_NAME=magento
DB_USER=magento
DB_PASSWORD=
DB_ROOT_PASSWORD=
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=

# Used by `kapelos magento-install` for the first admin account.
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=
MAGENTO_ADMIN_EMAIL=admin@example.test
MAGENTO_ADMIN_URI=admin

# Image versions. Change one to match what your Magento release supports.
PHP_VERSION=8.4
NODE_VERSION=22
NGINX_VERSION=1.30
VARNISH_VERSION=8.0
TRAEFIK_VERSION=v3.7
MARIADB_VERSION=11.8
# OpenSearch publishes no minor tags, so this names a release.
OPENSEARCH_VERSION=3.6.0
RABBITMQ_VERSION=4.3-management-alpine
VALKEY_VERSION=9.0-alpine
MAILPIT_VERSION=v1.31
